generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id
  name      String
  company   String
  status    String
  priority  String
  projects  Project[]

  @@index([status])
  @@index([priority])
}

model Project {
  id        String    @id
  name      String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  repo      String
  status    String
  milestone String
  agentLane String
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([status])
  @@index([repo])
}

model AgentRun {
  id           String   @id
  agent        String
  role         String
  project      String
  task         String
  status       String
  startTime    DateTime @default(now())
  duration     String
  failureCount Int      @default(0)
  linkedPR     String?

  @@index([status])
  @@index([startTime])
  @@index([project])
}

model ActivityEvent {
  id          String   @id
  type        String
  timestamp   DateTime @default(now())
  actorName   String
  targetId    String
  targetTitle String
  targetType  String
  metadata    String?

  @@index([timestamp])
  @@index([type])
  @@index([targetType, targetId])
}
